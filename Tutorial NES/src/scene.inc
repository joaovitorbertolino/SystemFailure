;==============================================================================
; scene.inc - NAMETABLE 0: 32 colunas x 30 linhas de tiles (960 bytes)
;              + TABELA DE ATRIBUTOS (64 bytes)  =  1024 bytes no total
;==============================================================================
; Cada byte da nametable é o NÚMERO de um tile da tabela de padrões do fundo.
; Tile $00 = vazio (mostra a cor de fundo universal = céu).
; Tiles usados: $01 tijolo  $02 grama  $03 terra  $04-$07 nuvem  $08 barras  $09 coração
scene:

    ; 1 linha(s) vazias (32 bytes)
    .repeat 32
        .byte $00
    .endrepeat
    ; linha 1
    .byte $00,$00,$09,$09,$09,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00     ; colunas 0-15
    .byte $00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00     ; colunas 16-31
    ; 1 linha(s) vazias (32 bytes)
    .repeat 32
        .byte $00
    .endrepeat
    ; linha 3
    .byte $00,$00,$00,$00,$00,$00,$00,$00,$04,$05,$00,$00,$00,$00,$00,$00     ; colunas 0-15
    .byte $00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00     ; colunas 16-31
    ; linha 4
    .byte $00,$00,$00,$00,$00,$00,$00,$00,$06,$07,$00,$00,$00,$00,$00,$00     ; colunas 0-15
    .byte $00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00     ; colunas 16-31
    ; linha 5
    .byte $00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00     ; colunas 0-15
    .byte $00,$00,$00,$00,$00,$00,$04,$05,$00,$00,$00,$00,$00,$00,$00,$00     ; colunas 16-31
    ; linha 6
    .byte $00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00     ; colunas 0-15
    .byte $00,$00,$00,$00,$00,$00,$06,$07,$00,$00,$00,$00,$00,$00,$00,$00     ; colunas 16-31
    ; 5 linha(s) vazias (160 bytes)
    .repeat 160
        .byte $00
    .endrepeat
    ; linha 12
    .byte $00,$00,$00,$00,$08,$08,$00,$00,$00,$00,$08,$08,$00,$00,$00,$00     ; colunas 0-15
    .byte $08,$08,$00,$00,$00,$00,$08,$08,$00,$00,$00,$00,$00,$00,$00,$00     ; colunas 16-31
    ; linha 13
    .byte $00,$00,$00,$00,$08,$08,$00,$00,$00,$00,$08,$08,$00,$00,$00,$00     ; colunas 0-15
    .byte $08,$08,$00,$00,$00,$00,$08,$08,$00,$00,$00,$00,$00,$00,$00,$00     ; colunas 16-31
    ; 12 linha(s) vazias (384 bytes)
    .repeat 384
        .byte $00
    .endrepeat
    ; linha 26
    .byte $02,$02,$02,$02,$02,$02,$02,$02,$02,$02,$02,$02,$02,$02,$02,$02     ; colunas 0-15
    .byte $02,$02,$02,$02,$02,$02,$02,$02,$02,$02,$02,$02,$02,$02,$02,$02     ; colunas 16-31
    ; linha 27
    .byte $03,$03,$03,$03,$03,$03,$03,$03,$03,$03,$03,$03,$03,$03,$03,$03     ; colunas 0-15
    .byte $03,$03,$03,$03,$03,$03,$03,$03,$03,$03,$03,$03,$03,$03,$03,$03     ; colunas 16-31
    ; linha 28
    .byte $01,$01,$01,$01,$01,$01,$01,$01,$01,$01,$01,$01,$01,$01,$01,$01     ; colunas 0-15
    .byte $01,$01,$01,$01,$01,$01,$01,$01,$01,$01,$01,$01,$01,$01,$01,$01     ; colunas 16-31
    ; linha 29
    .byte $01,$01,$01,$01,$01,$01,$01,$01,$01,$01,$01,$01,$01,$01,$01,$01     ; colunas 0-15
    .byte $01,$01,$01,$01,$01,$01,$01,$01,$01,$01,$01,$01,$01,$01,$01,$01     ; colunas 16-31

;------------------------------------------------------------------------------
; TABELA DE ATRIBUTOS: 8x8 bytes. Cada byte cobre 4x4 tiles (32x32 pixels) e guarda
; a paleta (0-3) de 4 quadrantes de 16x16 pixels:  %BR BL TR TL  (2 bits cada)
;------------------------------------------------------------------------------
scene_attr:
    .byte %00001100,%00000011,%00000000,%00000000,%00000000,%00000000,%00000000,%00000000   ; tiles das linhas 0-3
    .byte %00000000,%00000000,%00000000,%00000000,%00000000,%00000000,%00000000,%00000000   ; tiles das linhas 4-7
    .byte %00000000,%00000000,%00000000,%00000000,%00000000,%00000000,%00000000,%00000000   ; tiles das linhas 8-11
    .byte %00000000,%00000000,%00000100,%00000000,%00000010,%00001100,%00000000,%00000000   ; tiles das linhas 12-15
    .byte %00000000,%00000000,%00000000,%00000000,%00000000,%00000000,%00000000,%00000000   ; tiles das linhas 16-19
    .byte %00000000,%00000000,%00000000,%00000000,%00000000,%00000000,%00000000,%00000000   ; tiles das linhas 20-23
    .byte %01010000,%01010000,%01010000,%01010000,%01010000,%01010000,%01010000,%01010000   ; tiles das linhas 24-27
    .byte %00001010,%00001010,%00001010,%00001010,%00001010,%00001010,%00001010,%00001010   ; tiles das linhas 28-31
